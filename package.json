{
  "name": "arma3-preset-merger",
  "private": true,
  "version": "0.1.0",
  "description": "Extract client-side mods from an Arma 3 Launcher preset and merge them into a new base modpack.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "update-collections": "node scripts/update-collections.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
